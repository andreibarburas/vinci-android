<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Daily follow-up reminders fire from a WorkManager periodic job, so no exact-alarm
         permission is needed. READ_CALENDAR covers the calendar-aware nudge feature; the
         permission is requested at runtime from Settings, not demanded on first launch. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Feature #ContactContract: two-way ContactsContract sync, only acted on once the user
         turns on Settings -> "Sync with Android Contacts" (READ/WRITE_CONTACTS above already
         cover the data access; these two are for the account/sync-adapter plumbing itself). -->
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />

    <queries>
        <package android:name="com.brbrs.koto" />
        <package android:name="com.brbrs.tavla" />
        <package android:name="com.brbrs.nota" />
        <package android:name="com.whatsapp" />
        <package android:name="org.thoughtcrime.securesms" />
    </queries>

    <application
        android:name=".VinciApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Vinci"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Nextcloud Login Flow v2 callback -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vinci" android:host="login" />
            </intent-filter>
        </activity>

        <!-- Call state receiver — listens for call end to trigger post-call log -->
        <receiver
            android:name=".receiver.CallReceiver"
            android:exported="true"
            android:permission="android.permission.READ_PHONE_STATE">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
                <action android:name="android.intent.action.NEW_OUTGOING_CALL" />
            </intent-filter>
        </receiver>

        <!-- FileProvider for sharing exported data (Markdown/CSV) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.brbrs.vinci.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Quick-note receiver — handles inline reply from post-call notification -->
        <receiver
            android:name=".receiver.QuickNoteReceiver"
            android:exported="false" />

        <!-- "Mark done" action from the daily follow-up summary notification. -->
        <receiver
            android:name=".receiver.FollowUpActionReceiver"
            android:exported="false" />

        <!-- Feature #ContactContract: two-way ContactsContract sync. Both services are only
             ever bound by the OS's own account/sync-adapter machinery (exported must be true for
             that), guarded by the standard platform signature permissions so no other app can
             bind them directly. -->
        <service
            android:name=".sync.contract.VinciAuthenticatorService"
            android:exported="true"
            android:permission="android.permission.BIND_AUTHENTICATOR">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data
                android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/vinci_authenticator" />
        </service>

        <service
            android:name=".sync.contract.ContactsSyncAdapterService"
            android:exported="true"
            android:permission="android.permission.BIND_SYNC_ADAPTER">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                android:name="android.content.SyncAdapter"
                android:resource="@xml/vinci_syncadapter" />
        </service>

        <!-- WorkManager is configured via Hilt (see VinciApp), so the default
             on-demand initializer must be removed -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- uCrop: used for cropping a picked image before saving it as a contact photo -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

        <!-- Share-sheet capture: share a link, text, or image from any app straight into Vinci -->
        <activity
            android:name=".ShareReceiverActivity"
            android:exported="true"
            android:theme="@style/Theme.Vinci">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

    </application>
</manifest>
